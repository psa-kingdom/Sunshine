# ==============================================================================
# SUNSHINE PUBLIC SCHOOL — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

# 1. MongoDB Atlas Connection String
# Get this from MongoDB Atlas Dashboard -> Database -> Connect -> Drivers
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sunshine?retryWrites=true&w=majority"

# 2. Auth.js / NextAuth v5 Secret
# Generate a secure 32-character random string using PowerShell:
# [Convert]::ToBase64String((1..32 | % { Get-Random -Minimum 0 -Maximum 256 }))
# Or using OpenSSL: openssl rand -hex 32
AUTH_SECRET="your-32-character-secret-key-here"

# 3. Application Base URL
# URL of your production site (e.g., https://sunshine-public-school.vercel.app)
AUTH_URL="https://your-app.vercel.app"
NEXTAUTH_URL="https://your-app.vercel.app"

# 4. Vercel Blob Storage Token (Required for image/video upload features in production)
# Get this from Vercel Dashboard -> Storage -> Create Blob Store
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
